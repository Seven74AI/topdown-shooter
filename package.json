{
  "name": "topdown-shooter",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w @topdown/client\" \"npm run dev -w @topdown/server\"",
    "build": "npm run build -w @topdown/client",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "bots": "tsx tools/bots/run.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.10",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
