{
  "name": "topdown-shooter",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w @topdown/client\" \"npm run dev -w @topdown/server\"",
    "build": "npm run build -w @topdown/client",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:fast": "vitest run --project unit --maxWorkers=${VITEST_MAX_WORKERS:-4}",
    "test:slow": "vitest run --project slow",
    "test:changed": "vitest run --changed origin/master",
    "release:check": "npm run build && REQUIRE_DIST=1 vitest run tools/checks/noCheatsInRelease.test.ts",
    "gate:fast": "concurrently -n typecheck,lint,test:fast -c blue,yellow,green \"npm run typecheck\" \"npm run lint\" \"npm run test:fast\" && npm run release:check",
    "gate": "npm run typecheck && npm run lint && npm run release:check && npm test",
    "bots": "tsx tools/bots/run.ts",
    "db:generate": "npm run db:generate -w @topdown/server",
    "db:migrate": "npm run db:migrate -w @topdown/server",
    "maps:build": "tsx tools/maps/buildDowntown.ts",
    "maps:sync": "tsx tools/maps/buildDowntown.ts --sync",
    "gallery:export": "tsx tools/gallery/export.ts",
    "art:street-props": "tsx tools/art/streetProps.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.10",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
