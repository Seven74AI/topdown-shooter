{
  "name": "@topdown/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ALLOW_SOLO_START=1 tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrateCli.ts",
    "admin": "tsx src/db/adminCli.ts",
    "reports": "tsx src/db/reportsCli.ts",
    "housekeeping": "tsx src/db/housekeepingCli.ts",
    "stats": "tsx src/db/statsCli.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.29",
    "@colyseus/schema": "5.0.50",
    "@colyseus/ws-transport": "0.18.5",
    "@node-rs/argon2": "2.2.2",
    "@topdown/shared": "*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.10",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.11",
    "@electric-sql/pglite": "0.5.16",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
