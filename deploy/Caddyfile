# The web container of deploy/docker-compose.yml (Story 2.2): the client build and a same-origin
# proxy to the game server. Plain HTTP on :8080; the compose file publishes it on 127.0.0.1:8080
# only, where the Cloudflare Tunnel `sevend-io-stream` picks it up. Cloudflare terminates HTTPS and
# WSS at the edge (automatic certificates), so there is no TLS and no ACME here.
{
	admin off
	auto_https off
}

# Security headers, and no Server/Via banner. Imported in the site and in handle_errors, because
# Caddy's own error responses (404 for a missing asset, 413 for a big body) skip the site's routes.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
		-Via
	}
}

:8080 {
	import security_headers

	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# Story 10.6 (B2): Report a problem carries a note and 200 log lines: the ONE path allowed 64KiB = 65,536 bytes,
	# the server's REPORT_MAX_BYTES (re-review RR-M1: Caddy's "64KB" is 64,000). More specific than /api/*, so Caddy
	# tries it first; every other path keeps 8KB.
	handle /api/account/report {
		uri strip_prefix /api
		request_body {
			max_size 64KiB
		}
		reverse_proxy server:2567 {
			header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
		}
	}

	# Game server: the client talks to `${location.origin}/api` (Story 2.1). `/api` is stripped, so
	# matchmaking is /matchmake/* and the WebSocket /<processId>/<roomId> on server:2567.
	handle_path /api/* {
		# A real client sends a few hundred bytes (join options); the server refuses more anyway.
		# Bigger bodies get 413 here, before they reach Node.
		request_body {
			max_size 8KB
		}
		reverse_proxy server:2567 {
			# Per-IP limits (room creation) need the player's address, not cloudflared's. Colyseus reads
			# X-Real-IP first. Safe because only cloudflared can reach this port (127.0.0.1), and
			# Cloudflare always sets Cf-Connecting-Ip itself.
			header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
		}
	}

	# `/api` without the slash is not the app: a 404, never index.html.
	handle /api {
		respond "Not Found" 404
	}

	encode zstd gzip

	# Vite's hashed build files: cache for a year. No try_files here: a missing asset must be a 404,
	# never index.html with an immutable header (that would break the phone on the next deploy).
	# Trap for later: files in apps/client/public/assets/ are copied here WITHOUT a hash and would get
	# this immutable header too. Unhashed public files must live outside /assets/ (e.g. /static/), or
	# be imported so Vite hashes them.
	handle /assets/* {
		root * /srv/client
		@exists file
		# Only on files that exist: the 404 itself must not be cached for a year.
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: index.html and unhashed files, always revalidated. Unknown paths such as the
	# share link /j/<code> load the app.
	handle {
		root * /srv/client
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
